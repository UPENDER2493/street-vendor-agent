# Copy this file to `.env` and fill in your real values.
# Get these from https://cloud.ibm.com (IBM Cloud Lite account) -> watsonx.ai -> your project.

# IBM Cloud API key (Manage -> Access (IAM) -> API keys -> Create)
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai Project ID (open your watsonx.ai project -> Manage tab -> "Project ID")
WATSONX_PROJECT_ID=your_project_id_here

# Region URL for your watsonx.ai instance. Common options:
#   Dallas:    https://us-south.ml.cloud.ibm.com
#   Frankfurt: https://eu-de.ml.cloud.ibm.com
#   London:    https://eu-gb.ml.cloud.ibm.com
#   Tokyo:     https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model to use (see watsonx.ai "Foundation models" catalog for available IDs)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
